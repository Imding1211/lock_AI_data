# ── Environment & Secrets ─────────────────────────────────────────────
.env

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# ── macOS ─────────────────────────────────────────────────────────────
.DS_Store

# ── IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Large binary / media files ────────────────────────────────────────
storage/raw/video/*.MOV
storage/raw/video/*.mp4
storage/raw/youtube/*.mp4
storage/raw/line_chat/*.csv

# ── Large binary / media files ────────────────────────────────────────
storage/bronze/line_chat/*.csv

