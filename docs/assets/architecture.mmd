---
config:
  layout: dagre
  theme: base
  themeVariables:
    primaryColor: '#4A90D9'
    primaryTextColor: '#1a1a1a'
    lineColor: '#5A6A7A'
    edgeLabelBackground: '#ffffff'
    tertiaryTextColor: '#1a1a1a'
    fontSize: 14px
---
graph TD
    subgraph RAW ["Raw Layer (原始層)"]
        direction LR
        A1["Line Chat<br/>.csv"]
        A2["Video<br/>.mp4"]
        A3["Website<br/>.txt"]
        A4["YouTube<br/>.mp4"]
        A5["GDrive<br/>links.txt"]
    end

    subgraph BRONZE ["Bronze Layer (粗抽取層)"]
        direction LR
        B1["Line Chat<br/>.csv"]
        B2["Video<br/>.txt"]
        B3["Website<br/>.md"]
        B4["YouTube<br/>.json"]
        B5["GDrive<br/>.json"]
    end

    subgraph SILVER ["Silver Layer (結構化中台)"]
        direction LR
        C1("process_line.py")
        C2("process_video.py")
        C3("process_website.py")
        C4("process_youtube.py")
        C5("process_gdrive.py")
    end

    D["標準化 Document JSON<br/>page_content + metadata"]

    subgraph GOLD ["Gold Layer (向量檢索庫)"]
        E("seed_pgvector.py")
        F1[("kb_line_chat")]
        F2[("kb_video")]
        F3[("kb_website")]
        F4[("kb_youtube")]
        F5[("kb_gdrive")]
    end
    A1 -->|"去識別化 / 過濾"| B1
    A2 -->|"ASR 語音轉文字"| B2
    A3 -->|"網頁去噪 / 提取"| B3
    A4 -->|"Vision 逐幀解析"| B4
    A5 -->|"Drive API 索引"| B5

    B1 -->|"主題聚合 / 結構化"| C1
    B2 -->|"語音糾錯 / 去冗言"| C2
    B3 -->|"語意切分 / HyDE"| C3
    B4 -->|"語意切分 / HyDE"| C4
    B5 -->|"語意切分 / HyDE"| C5

    C1 & C2 & C3 & C4 & C5 -->|"產出"| D

    D -->|"直接轉換為 Documents"| E

    E -->|"Upsert"| F1 & F2 & F3 & F4 & F5
    subgraph AI ["AI Services (服務工廠)"]
        direction TB
        LLM_F["LLM Factory<br/><i>Gemini 2.5 Flash</i>"]
        EMB_F["Embedding Factory<br/><i>text-embedding-004</i>"]
    end

